FRONTEND_URL=http://192.168.1.46:3100
SAFE_FETCH_ALLOW_PRIVATE_NETWORK=true
SECRET_KEY_BASE=generate-at-install
POSTGRES_PASSWORD=generate-at-install
REDIS_PASSWORD=generate-at-install
DATABASE_URL=postgresql://postgres:generate-at-install@postgres:5432/chatwoot
REDIS_URL=redis://:generate-at-install@redis:6379
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
DEFAULT_LOCALE=tr
ACTIVE_STORAGE_SERVICE=local
