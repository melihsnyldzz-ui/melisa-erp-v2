{
  "name": "@melisa-erp/terminal-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "start:lan": "expo start --clear --lan --go",
    "start:tunnel": "expo start --clear --tunnel --go",
    "android": "expo start --android",
    "web": "expo start --web",
    "doctor": "npx expo-doctor",
    "check:all": "node scripts/check-terminal-all.mjs",
    "check:api": "node scripts/check-terminal-api.mjs",
    "check:submit": "node scripts/check-terminal-submit.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.35",
    "expo-build-properties": "1.0.10",
    "expo-secure-store": "15.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "0.21.2"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "babel-preset-expo": "54.0.10"
  }
}
