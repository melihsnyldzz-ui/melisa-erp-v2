API_PORT=4100
APP_NAME=melisa-erp-api
NODE_ENV=development
API_VERSION=v0.1.0
CORS_ORIGINS=http://localhost:5173,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5175,http://192.168.1.47:5173,http://192.168.1.47:5175,http://localhost:19006
REQUEST_BODY_LIMIT=50mb
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
SLOW_REQUEST_MS=1500
SQL_SERVER=
SQL_PORT=
SQL_DATABASE=
SQL_ODBC_DRIVER=ODBC Driver 17 for SQL Server
SQL_USER=
SQL_PASSWORD=
SQL_TRUSTED_CONNECTION=false
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERTIFICATE=true
SQL_READ_ONLY=true

# Bionic read-only SQL integration. Keep disabled until a SELECT-only SQL login is configured.
BIONIC_READ_ONLY_ENABLED=false
BIONIC_READ_ONLY_API_KEY=
BIONIC_ERP_PUBLIC_BASE_URL=http://host.docker.internal:4100/api
BIONIC_READ_ONLY_MAX_ROWS=500
BIONIC_READ_ONLY_MAX_TABLES=200
BIONIC_READ_ONLY_MAX_QUERY_CHARS=10000
BIONIC_READ_ONLY_QUERY_TIMEOUT_MS=15000

# Vega is a separate, read-only source. Do not use the sa account here.
VEGA_SQL_SERVER=
VEGA_SQL_PORT=1433
VEGA_SQL_DATABASE=VEGA2026
VEGA_SQL_USER=melisa_stock_ro
VEGA_SQL_PASSWORD=
VEGA_SQL_ENCRYPT=false
VEGA_SQL_TRUST_SERVER_CERTIFICATE=true
VEGA_COMPANY_CODE=F0102
VEGA_PERIOD_CODE=D0007
VEGA_YEAR=2026
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=evolution
WHATSAPP_API_URL=http://localhost:8080
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE=melisa
WHATSAPP_PUBLIC_API_URL=http://localhost:4100
WHATSAPP_TIMEOUT_MS=20000
WHATSAPP_SEND_DELAY_MS=1200

# FedEx is reached only through the separate Nakliyat HTTP API.
# All external write/rate gates are intentionally off by default.
NAKLIYAT_ENABLED=true
NAKLIYAT_API_BASE_URL=http://127.0.0.1:44555
NAKLIYAT_SERVICE_EMAIL=
NAKLIYAT_SERVICE_PASSWORD=
NAKLIYAT_TIMEOUT_MS=20000
NAKLIYAT_ALLOW_PRODUCTION_RATES=false
NAKLIYAT_ALLOW_DRAFT_CREATE=false
NAKLIYAT_ALLOW_CUSTOMER_QUOTE_CREATE=false
NAKLIYAT_ALLOW_FINALIZE=false

# Terminal fis yazdirma ERP API'nin calistigi Windows bilgisayarda yapilir.
# Yazici adi bos birakilirsa Windows varsayilan yazicisi kullanilir.
TERMINAL_RECEIPT_PRINT_ENABLED=true
TERMINAL_RECEIPT_PRINT_MODE=windows
TERMINAL_RECEIPT_PRINTER_NAME=
TERMINAL_RECEIPT_PRINT_TIMEOUT_MS=20000